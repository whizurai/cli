# @whizurai packages (sdk-js) are published to GitHub Packages, not npmjs.
# This file only maps the scope; the token lives in the user-level ~/.npmrc
# (locally: `//npm.pkg.github.com/:_authToken=...` with read:packages on the
# whizurai org; in CI: setup-node `registry-url` + NODE_AUTH_TOKEN).
@whizurai:registry=https://npm.pkg.github.com
